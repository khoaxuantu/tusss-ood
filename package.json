  "description": "An out-of-nowhere object-oriented data/design library.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "core:build": "pnpm run --filter @tusss/ood build",
    "core:test": "pnpm run --filter @tusss/ood test",
