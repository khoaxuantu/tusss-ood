{
  "name": "@tusss/ood",
  "version": "1.0.0",
  "description": "An out-of-nowhere object-oriented data/design library.",
  "keywords": [
    "oop",
    "ood",
    "oo",
    "object oriented design"
  ],
  "type": "module",
  "author": "Xuan Khoa Tu Nguyen",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/index.js",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "bun run build.ts && bun run build:types",
    "build:types": "tsc --project d.tsconfig.json --emitDeclarationOnly",
    "check:types": "tsc --noEmit --project d.tsconfig.json",
    "test": "bun test"
  },
  "sideEffects": false
}
