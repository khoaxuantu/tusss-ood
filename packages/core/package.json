{
  "name": "@tusss/ood",
  "version": "1.0.1",
  "description": "An out-of-nowhere object-oriented data/design library.",
  "keywords": [
    "oop",
    "ood",
    "oo",
    "object oriented design",
    "data"
  ],
  "type": "module",
  "author": "Xuan Khoa Tu Nguyen",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "devDependencies": {
    "@std/expect": "jsr:^1.0.19",
    "@std/testing": "jsr:^1.0.19",
    "@types/bun": "^1.3.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "imports": {
    "#test": {
      "bun": "./test/bun.ts",
      "deno": "./test/deno.ts",
      "default": "./test/node.ts"
    }
  },
  "scripts": {
    "prebuild": "rimraf dist && rimraf d.tsconfig.tsbuildinfo",
    "build": "bun run check:types && bun run build:compile && bun run build:types",
    "build:compile": "bun run build.ts",
    "build:types": "tsc --project d.tsconfig.json",
    "check:types": "tsc --noEmit --project d.tsconfig.json",
    "test:bun": "bun test",
    "test:node": "vitest run",
    "test:deno": "deno test src/**/*.test.ts --no-check --sloppy-imports",
    "test": "bun run test:bun && bun run test:node && bun run test:deno"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/khoaxuantu/tusss-ood.git"
  },
  "homepage": "https://khoaxuantu.github.io/tusss-ood",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
